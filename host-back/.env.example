# ===== API =====
NODE_ENV=development
PORT=3333

# ===== PostgreSQL (usado pelo docker-compose) =====
POSTGRES_USER=sepol
POSTGRES_PASSWORD=troque-por-uma-senha
POSTGRES_DB=sepol_host
POSTGRES_PORT=5432

# Conexão usada quando a API roda FORA do Docker (npm run dev).
# Dentro do Docker o compose sobrescreve para o host "db".
DATABASE_URL=postgres://sepol:troque-por-uma-senha@localhost:5432/sepol_host

# ===== Autenticação =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN_REMEMBER=30d

# Origens do front permitidas (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# true em produção com HTTPS
COOKIE_SECURE=false

# ===== Redefinição de senha =====
# URL pública do front (vai no link enviado por e-mail)
APP_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MIN=30

# ===== E-mail (SMTP) =====
# Deixe SMTP_HOST vazio em desenvolvimento: o link de redefinição aparece no log da API.
# SMTP_SECURE=true para porta 465; false para 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sepol Host <no-reply@sepol.com.br>

# ===== Arquivos enviados (fotos de documento) =====
# Pasta relativa à raiz do back. No Docker é o volume "uploads" (/app/uploads).
UPLOADS_DIR=uploads

# ===== Usuário administrador inicial (criado pelo seed) =====
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sepol.com.br
ADMIN_PASSWORD=Admin@123
