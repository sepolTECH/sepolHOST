# Copie para ".env" na VPS (cp .env.production.example .env) e preencha TUDO.
# Nunca envie o arquivo .env para o Git.

# ===== Domínio (o DNS tipo A precisa apontar para o IP da VPS) =====
DOMAIN=host.seudominio.com.br

# ===== Banco de dados =====
POSTGRES_USER=sepol
POSTGRES_PASSWORD=TROQUE-por-uma-senha-longa
POSTGRES_DB=sepol_host

# ===== Segurança =====
# Gere com:  openssl rand -hex 48
JWT_SECRET=TROQUE-gere-com-openssl-rand-hex-48
JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN_REMEMBER=30d

# true = qualquer pessoa pode criar conta em /cadastro (cada conta = um cliente com dados próprios)
# false = só você cria clientes (comando user:create, veja o DEPLOY.md)
ALLOW_REGISTRATION=true

# ===== Primeiro administrador (criado na 1ª subida, só se ainda não existir) =====
ADMIN_NAME=Administrador
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=TROQUE-uma-senha-forte-com-letras-e-numeros

# ===== E-mail (recuperação de senha) =====
# Sem SMTP_HOST o link de redefinição só aparece no log da API (não chega ao cliente).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sepol Host <no-reply@seudominio.com.br>
